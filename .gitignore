# ==================================================
# PRODUCTION FLUTTER + BACKEND + SUPABASE
# ==================================================

# -------------------------------
# OS / SYSTEM
# -------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -------------------------------
# IDEs
# -------------------------------
.idea/
.vscode/
*.iml
*.sublime-project
*.sublime-workspace
*.history

# -------------------------------
# FLUTTER / DART CORE
# -------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/
coverage/

# -------------------------------
# ENVIRONMENT SECRETS (CRITICAL)
# -------------------------------
.env
.env.*
*.env

# -------------------------------
# BACKEND (Python / Node safe layer)
# -------------------------------
backend/.env
backend/.venv/
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/*.log
backend/node_modules/

# -------------------------------
# SUPABASE (IMPORTANT SECURITY LAYER)
# -------------------------------
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.secrets
supabase/config.toml.local

# ⚠️ DO NOT commit service role keys or anon secrets backups
*.supabase
*.db-journal

# -------------------------------
# ANDROID
# -------------------------------
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/

# -------------------------------
# IOS
# -------------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/.last_build_id

# -------------------------------
# MACOS / WINDOWS / LINUX
# -------------------------------
macos/Flutter/ephemeral/
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# -------------------------------
# WEB
# -------------------------------
web/.dart_tool/

# -------------------------------
# FIREBASE / SUPABASE GENERATED FILES
# -------------------------------
firebase_options.dart
google-services.json
GoogleService-Info.plist

# -------------------------------
# LOGS / DEBUG
# -------------------------------
*.log
debug.log

# -------------------------------
# LOCAL DEV FLAGS
# -------------------------------
*.local
*.dev
# -------------------------------
# PYTHON BACKEND
# -------------------------------
python_backend/venv/
python_backend/.venv/
python_backend/__pycache__/
python_backend/**/__pycache__/
python_backend/**/*.pyc
python_backend/**/*.pyo
python_backend/logs/
python_backend/storage/temp_uploads/
python_backend/storage/output/
python_backend/storage/jobs/
python_backend/project_structure.txt

# -------------------------------
# DATA / DOCUMENTS
# -------------------------------
*.xlsx
*.csv

